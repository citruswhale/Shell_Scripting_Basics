# Copy to terraform.tfvars if you want to change defaults. No secrets.
aws_region         = "ap-south-1"
cluster_name       = "gearloan-eks"
kubernetes_version = "1.37"
vpc_name           = "gearloan-vpc"
node_instance_type = "t3.medium"
node_min_size      = 2
node_max_size      = 3
node_desired_size  = 2
node_disk_size     = 20
